rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSharedEditor() {
      return request.auth != null
        && request.auth.token.email == "operador@ka-paradas.app";
    }

    function hasAuditMetadata() {
      return request.resource.data.updatedBy is string
        && request.resource.data.updatedBy.size() > 0
        && request.resource.data.editorSessionId is string
        && request.resource.data.editorSessionId.size() > 0
        && request.resource.data.updatedAt == request.time;
    }

    // Dashboard e Curva S permanecem públicos. A mesma conta de editor pode
    // ser usada em vários computadores; conflitos são resolvidos por atividade.
    match /ka_free_state_v2/{document} {
      allow read: if true;
      allow create, update: if isSharedEditor() && hasAuditMetadata();
      allow delete: if false;
    }

    match /ka_free_activity_buckets_v2/{document} {
      allow read: if true;
      allow create, update: if isSharedEditor() && hasAuditMetadata();
      allow delete: if false;
    }

    // Cada conta de disciplina grava somente um documento de avanço. O painel
    // também confere se o e-mail corresponde à disciplina da atividade antes
    // de aplicar o registro sobre a base principal.
    match /ka_discipline_progress_v2/{document} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly([
          "activityId", "disciplineKey", "disciplineName", "editorEmail",
          "progresso", "status", "obs", "inicioReal", "terminoReal", "updatedBy", "editorSessionId", "updatedAt"
        ])
        && request.resource.data.activityId is string
        && request.resource.data.disciplineKey is string
        && request.resource.data.disciplineName is string
        && request.resource.data.editorEmail is string
        && request.resource.data.progresso is number
        && request.resource.data.progresso >= 0
        && request.resource.data.progresso <= 100
        && request.resource.data.status is string
        && request.resource.data.obs is string
        && request.resource.data.inicioReal is string
        && request.resource.data.inicioReal.size() <= 40
        && request.resource.data.terminoReal is string
        && request.resource.data.terminoReal.size() <= 40
        && request.resource.data.updatedBy is string
        && request.resource.data.editorSessionId is string
        && request.resource.data.updatedAt == request.time
        && (isSharedEditor() || request.resource.data.editorEmail == request.auth.token.email);
      allow delete: if isSharedEditor();
    }

    // Modo economico: poucos blocos por disciplina substituem centenas de
    // documentos individuais. A colecao v2 permanece como recuperacao.
    match /ka_discipline_progress_groups_v3/{document} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly([
          "disciplineKey", "disciplineName", "editorEmail", "entries",
          "updatedBy", "editorSessionId", "updatedAt"
        ])
        && request.resource.data.disciplineKey is string
        && request.resource.data.disciplineName is string
        && request.resource.data.editorEmail is string
        && request.resource.data.entries is list
        && request.resource.data.entries.size() <= 250
        && request.resource.data.updatedBy is string
        && request.resource.data.updatedBy.size() > 0
        && request.resource.data.editorSessionId is string
        && request.resource.data.editorSessionId.size() > 0
        && request.resource.data.updatedAt == request.time
        && (isSharedEditor() || request.resource.data.editorEmail == request.auth.token.email);
      allow delete: if isSharedEditor();
    }

    // Documentos antigos da trava são mantidos inacessíveis e deixam de ser
    // usados pela aplicação. Isso evita depender de uma limpeza destrutiva.
    match /ka_editor_lock/{document} {
      allow read, write: if false;
    }

    match /ka_editor_presence/{document} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
