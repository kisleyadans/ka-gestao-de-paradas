{
  "auth": { "providers": { "emailPassword": true } },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "site": "ka-gestao-paradas-ceii",
    "public": "dist/clients/ceii",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": ["firebase.ceii.json", "**/.*", "**/node_modules/**"],
    "headers": [
      { "source": "**", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] }
    ],
    "rewrites": [{ "source": "**", "destination": "/index.html" }]
  }
}
